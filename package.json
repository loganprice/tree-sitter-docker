{
  "name": "tree-sitter-docker",
  "version": "0.1.0",
  "description": "Dockerfile grammar for tree-sitter",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "test": "tree-sitter test",
    "test:wasm": "tree-sitter test --wasm",
    "generate": "tree-sitter generate",
    "build": "tree-sitter generate && node-gyp rebuild",
    "build:wasm": "tree-sitter build --wasm"
  },
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "dockerfile",
    "docker"
  ],
  "author": "Logan Price",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loganprice/tree-sitter-docker.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/*",
    "tree-sitter.json"
  ],
  "dependencies": {
    "nan": "^2.19.0"
  },
  "devDependencies": {
    "tree-sitter": "^0.25.1",
    "tree-sitter-cli": "^0.27.0"
  },
  "tree-sitter": [
    {
      "scope": "source.dockerfile",
      "file-types": [
        "Dockerfile",
        "dockerfile",
        "Containerfile",
        "containerfile",
        "Dockerfile.*",
        "*.Dockerfile",
        "*.dockerfile"
      ],
      "injection-regex": "^(dockerfile|Dockerfile|docker|containerfile)$"
    }
  ]
}