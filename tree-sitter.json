{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "dockerfile",
      "camelcase": "Dockerfile",
      "title": "Dockerfile",
      "scope": "source.dockerfile",
      "file-types": [
        "Dockerfile",
        "dockerfile",
        "Containerfile",
        "containerfile",
        "Dockerfile.*",
        "*.Dockerfile",
        "*.dockerfile"
      ],
      "injection-regex": "^(dockerfile|Dockerfile|docker|containerfile)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Dockerfile grammar for tree-sitter",
    "authors": [
      {
        "name": "tree-sitter authors"
      }
    ]
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
